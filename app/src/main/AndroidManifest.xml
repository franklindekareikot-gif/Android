<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidLab1">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LinearLayoutActivity"
            android:exported="false"
            android:label="@string/menu_linear"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".TableLayoutActivity"
            android:exported="false"
            android:label="@string/menu_table"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Constraint1Activity"
            android:exported="false"
            android:label="@string/title_constraint1"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Constraint2Activity"
            android:exported="false"
            android:label="@string/menu_constraint2"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ComposeActivity"
            android:exported="false"
            android:label="@string/menu_compose"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ListViewActivity"
            android:exported="false"
            android:label="@string/title_listview"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CustomDialogActivity"
            android:exported="false"
            android:label="@string/title_dialog"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MenuXmlActivity"
            android:exported="false"
            android:label="@string/title_menu_test"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ActionModeActivity"
            android:exported="false"
            android:label="@string/title_action_mode"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RecyclerViewActivity"
            android:exported="false"
            android:label="@string/title_recycler"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
