<resources>
    <style name="Theme.AndroidLab1" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="LabToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">#212121</item>
        <item name="titleTextColor">#FFFFFF</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/btn_gray</item>
        <item name="android:textColor">#6E6E6E</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="layout_constraintHorizontal_weight">1</item>
    </style>
</resources>
