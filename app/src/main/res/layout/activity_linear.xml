<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        style="@style/LabToolbar"
        app:title="@string/menu_linear" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.0"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_one_one"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.5"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_one_two"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.3"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_one_three"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_one_four"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_two_one"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.5"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_two_two"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_two_three"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.0"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_two_four"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.4"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_three_one"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_three_two"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.2"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_three_three"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_three_four"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.0"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_four_one"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.5"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_four_two"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.3"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_four_three"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1.1"
                android:background="@drawable/cell_border"
                android:gravity="center"
                android:text="@string/cell_four_four"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
